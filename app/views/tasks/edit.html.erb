<div>
  <% if notice.present? %>
    <p><%= notice %></p>
  <% end %>

  <% if alert.present? %>
    <p><%= alert %></p>
  <% end %>
</div>

<% if @task.errors.any? %>
  <%= @task.errors.count %>件のエラーが発生しました
  <ul>
    <% @task.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<h1>編集画面</h1>
<%= form_with model: @task, url: task_path(@task.id), method: :patch do |f| %>
  <h4>タイトル</h4>
  <%= f.text_field :title %>

  <h4>詳細</h4>
  <%= f.text_area :description %>

  <%= f.submit '保存' %>
<% end %>
<%#= raise %>